#!/system/bin/sh
# mihomo watchdog (enhanced, 2026-09-29)
# Same mechanism as the Cat plugin: inotifyd watches /data/kano_mihomo/Clash;
# touching the disable file stops the core, deleting it resumes (emergency switch).
script_path=/data/kano_mihomo/Scripts

events=$1
monitor_file=$3

if [ "$monitor_file" = "disable" ]; then
    if [ "$events" = "n" ]; then
        $script_path/Clash.Service stop
    elif [ "$events" = "d" ]; then
        $script_path/Clash.Service start
    fi
fi
